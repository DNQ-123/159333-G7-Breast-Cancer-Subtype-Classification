{
  "model": "XGBoost(+focal/boost/rarity/margin/sample_weight)",
  "class_names": [
    "Basal-like",
    "HER2-enriched",
    "Luminal A",
    "Luminal B",
    "Solid Tissue Normal"
  ],
  "random_state": 42,
  "best_params": {
    "tree_method": "gpu_hist",
    "predictor": "gpu_predictor",
    "n_estimators": 400,
    "max_depth": 6,
    "learning_rate": 0.1
  },
  "class_weight_mode": "balanced",
  "enable_focal": false,
  "base_gamma": 3.5,
  "focal_two_pass": false,
  "class_boost_json": "{\"HER2-enriched\":1.5, \"Basal-like\":1.3, \"Luminal B\":1.2}",
  "rarity_multiplier": 1.2,
  "enable_margin": true,
  "margin_threshold": 0.1,
  "margin_weight": 0.5,
  "n_splits_cv": 3,
  "random_search_iters": 10
}